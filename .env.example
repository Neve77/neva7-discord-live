# BOT OFICIAL: cria em discord.com/developers/applications
# Escolha no site ou aqui: bot | selfbot. Em branco, mantém a seleção legada pelo token disponível.
DISCORD_MODE=
# Ativa em Bot: Presence Intent + Server Members Intent + Message Content Intent
# Convida com: Send Messages + Read Message History + Connect + Speak
BOT_TOKEN=
# Atividade visível no perfil do bot. Deixe em branco para não mostrar texto.
BOT_ACTIVITY=Conversando no Discord
# teu id de usuário (botão direito no teu perfil > Copiar ID, com modo dev ativo) — só tu configura ela
OWNER_ID=
# A voz do OWNER_ID tem prioridade na call. Descomente para trocar a pessoa prioritária;
# deixe vazio para dar o mesmo peso a todos (o interlocutor pode interromper a própria resposta).
# VOICE_PRIORITY_USER_ID=
# Token da conta pessoal, usado apenas no modo selfbot. O Discord proíbe esse uso.
TOKEN=
# Mensagens e falas espontâneas começam desligadas. 1 permite ativação explícita.
ALIVE_ENABLED=0
PROACTIVE_VOICE=0
# Groq para pensar e ouvir; Gemini para a voz nativa (chave de projeto Free Tier)
GEMINI_API_KEY=
# Conversa nativa em streaming: live | legacy (pipeline STT + LLM + TTS anterior).
# O modo Live exige bot oficial; configure em / → Conexão Discord.
VOICE_PIPELINE=live
GEMINI_LIVE_MODEL=gemini-3.8-live
# Entrada automática opcional ao iniciar (IDs de servidor e canal de voz).
LIVE_GUILD_ID=
LIVE_CHANNEL_ID=
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
# Para respostas de texto pelo Gemini, use CHAT_MODEL=gemini-3.6-flash.
# Esforço do GPT-OSS no Groq: low equilibra qualidade e tempo de resposta na call.
CHAT_REASONING_EFFORT=low
STT_MODEL=whisper-large-v3-turbo
# Detecção de PT-BR, espanhol e inglês. O painel mantém a entrada automática.
STT_LANGUAGE=auto
# Apelidos que fazem o bot responder sem @ (separados por vírgula)
WAKE_WORDS=neve,nevas,neva7
# Inclui raciocínio e resposta; o texto falado continua curto (até 300 caracteres).
MAX_TOKENS=1024
# Voz nativa pela Live API. Use edge para voltar ao serviço sem chave.
TTS_MODE=gemini
GEMINI_AUDIO_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Aoede
# Buffer inicial do áudio em streaming. 320 ms evita estalos por jitter; mínimo 160, máximo 1000.
GEMINI_STREAM_BUFFER_MS=320
# Ambos mantêm streaming. edge: usa Edge se Gemini falhar antes de começar a tocar.
TTS_FALLBACK=none
# Voz alternativa Edge PT-BR: francisca | thalita | antonio
# A escolha salva pelo painel tem prioridade sobre este valor inicial.
TTS_EDGE_VOICE=francisca
# Padrão independente do painel. No programa, Inteligência → Idiomas tem precedência.
TTS_LANGUAGE=auto
# Ritmo base: 0 preserva a velocidade natural. Ajuste fino pelo painel.
TTS_RATE_NUM=0
# Opcional para IA de texto/transcrição; nunca usado pela síntese de voz
OPENAI_API_KEY=
# Opcional: caminho completo do ffmpeg.exe se não estiver no PATH
FFMPEG_PATH=
# YouTube grátis: npm run setup:youtube instala em tools/. Caminho manual opcional:
YTDLP_PATH=
# Central web local (http://127.0.0.1:3210). Não é exposta na rede.
WEB_PANEL=1
WEB_PANEL_PORT=3210
# Painel de terminal é opcional; 1 o habilita junto da central web.
TERMINAL_PANEL=0
# Seleções iniciais opcionais do painel
PANEL_GUILD=
PANEL_CHANNEL=
